# StatusForge local development configuration.
# Copy to .env (git-ignored). Every value below is a non-secret local default.
# The backend reads only STATUSFORGE_* variables; it never reads AWS_* variables
# or ambient AWS credentials, and it rejects non-loopback listen addresses and
# non-loopback DynamoDB endpoints.

# Backend API listen address (must be a loopback host).
STATUSFORGE_HTTP_ADDR=127.0.0.1:8080

# DynamoDB Local (started by `make db-up`; the host port is published on 127.0.0.1 only).
STATUSFORGE_DYNAMODB_PORT=8000
STATUSFORGE_DYNAMODB_ENDPOINT=http://127.0.0.1:8000
STATUSFORGE_DYNAMODB_TABLE=statusforge
STATUSFORGE_DYNAMODB_REGION=local
# DynamoDB Local requires *some* credentials; these placeholders are not AWS credentials.
STATUSFORGE_DYNAMODB_ACCESS_KEY_ID=local
STATUSFORGE_DYNAMODB_SECRET_ACCESS_KEY=local

# Logging: level debug|info|warn|error, format text|json.
STATUSFORGE_LOG_LEVEL=info
STATUSFORGE_LOG_FORMAT=text

# Controlled sample target fixture (`make sample-target`), loopback only.
STATUSFORGE_SAMPLE_TARGET_ADDR=127.0.0.1:8090
STATUSFORGE_ALLOWED_TARGETS=127.0.0.1:8090

# Scheduler: fixed worker pool, interval floor (10/15/30 are development-only), and API-only drills.
STATUSFORGE_WORKERS=4
STATUSFORGE_MIN_INTERVAL_SECONDS=60
STATUSFORGE_SCHEDULER_ENABLED=true

# Local notification receiver fixture and delivery.
STATUSFORGE_RECEIVER_ADDR=127.0.0.1:8091
STATUSFORGE_NOTIFY_URL=http://127.0.0.1:8091/notify
STATUSFORGE_DELIVERY_WORKERS=1
STATUSFORGE_DELIVERY_RETRY_SCHEDULE=10s,30s,90s,5m,15m,30m
STATUSFORGE_REMINDER_INTERVAL_SECONDS=21600

# Web dev server (Vite) proxies /api to the backend.
STATUSFORGE_WEB_PORT=5173
STATUSFORGE_API_PROXY_TARGET=http://127.0.0.1:8080
